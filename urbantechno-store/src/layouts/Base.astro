---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustBar from '../components/TrustBar.astro';
import { SITE } from '../site.config.mjs';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  jsonLd?: object | object[];
  noindex?: boolean;
  trust?: boolean;
}
const { title, description, image, type = 'website', jsonLd, noindex = false, trust = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const fullTitle = title.includes(SITE.shortName) ? title : `${title} | ${SITE.name}`;
const ogImage = image ?? new URL('/og.jpg', Astro.site ?? SITE.url).href;
const ogAlt = image ? title : `${SITE.name}: tecnología original, garantía real`;

const org = {
  '@context': 'https://schema.org',
  '@type': 'OnlineStore',
  '@id': `${SITE.url}/#org`,
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/logo.svg`,
  image: `${SITE.url}/og.jpg`,
  description: SITE.description,
  telephone: `+${SITE.whatsapp}`,
  email: SITE.email,
  areaServed: { '@type': 'Country', name: 'Perú' },
  currenciesAccepted: 'PEN',
  paymentAccepted: 'Transferencia bancaria, Yape, Plin, Agora, tarjeta de crédito, tarjeta de débito',
  address: { '@type': 'PostalAddress', addressLocality: 'Lima', addressCountry: 'PE' },
  sameAs: [SITE.instagram, SITE.tiktok],
  contactPoint: { '@type': 'ContactPoint', contactType: 'customer service', telephone: `+${SITE.whatsapp}`, availableLanguage: 'es' },
  hasMerchantReturnPolicy: {
    '@type': 'MerchantReturnPolicy',
    applicableCountry: 'PE',
    returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
    merchantReturnDays: 2,
    returnMethod: 'https://schema.org/ReturnByMail',
    returnFees: 'https://schema.org/FreeReturn',
    url: `${SITE.url}/ayuda/cambios-y-devoluciones/`,
  },
};
const site = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.name,
  inLanguage: 'es-PE',
  publisher: { '@id': `${SITE.url}/#org` },
};
const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const schemas = Astro.url.pathname === '/' ? [org, site, ...extra] : [site, ...extra];
---
<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="theme-color" content="#30afff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type === 'product' ? 'product' : type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="application-name" content={SITE.name} />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Ir al contenido</a>
    <Header />
    {trust && <TrustBar />}
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/cart.ts"></script>
  </body>
</html>
<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--ink); color: #fff; padding: 10px 14px; border-radius: 8px; z-index: 100; }
  .skip:focus { left: 8px; }
</style>
