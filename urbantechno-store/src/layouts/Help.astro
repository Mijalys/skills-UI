---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import WaCta from '../components/WaCta.astro';
import { SITE } from '../site.config.mjs';
interface Props { title: string; h1?: string; description: string; summary: string[]; section?: 'Ayuda' | 'Legal'; jsonLd?: object | object[]; waMessage?: string; updated?: boolean }
const { title, h1 = title, description, summary, section = 'Ayuda', jsonLd, waMessage, updated = false } = Astro.props;
const base = section === 'Ayuda' ? '/ayuda/' : '/legal/terminos-y-condiciones/';
const links = section === 'Ayuda'
  ? [['/ayuda/envios/', 'Envíos'], ['/ayuda/pagos/', 'Pagos'], ['/ayuda/garantia/', 'Garantía'], ['/ayuda/cambios-y-devoluciones/', 'Cambios y devoluciones'], ['/seguimiento/', 'Seguimiento de pedido'], ['/ayuda/preguntas-frecuentes/', 'Preguntas frecuentes']]
  : [['/legal/terminos-y-condiciones/', 'Términos y condiciones'], ['/legal/politica-de-cambios-devoluciones-y-garantias/', 'Cambios, devoluciones y garantías'], ['/legal/politica-de-privacidad/', 'Política de privacidad'], ['/libro-de-reclamaciones/', 'Libro de Reclamaciones']];
const path = Astro.url.pathname;
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url }, { '@type': 'ListItem', position: 2, name: section, item: `${SITE.url}${base}` }, { '@type': 'ListItem', position: 3, name: h1, item: `${SITE.url}${path}` } ] };
const ld = jsonLd ? [crumbs, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])] : crumbs;
---
<Base title={title} description={description} jsonLd={ld}>
  <Breadcrumbs items={[{ name: section, href: base }, { name: h1 }]} />
  <div class="container help-grid">
    <article>
      <header class="page-hero">
        <h1>{h1}</h1>
        {updated && <p class="small muted">Última actualización: {SITE.updated}</p>}
        <p class="lead">{description}</p>
      </header>
      <div class="summary"><h2>En resumen</h2><ul>{summary.map((s) => <li>{s}</li>)}</ul></div>
      <div class="prose"><slot /></div>
    </article>
    <aside class="side">
      <div class="card card-pad">
        <h4>{section}</h4>
        <ul class="side-links">{links.map(([href, name]) => <li><a href={href} aria-current={path === href ? 'page' : undefined}>{name}</a></li>)}</ul>
      </div>
      <div class="card card-pad side-wa">
        <h4>¿Necesitas ayuda?</h4>
        <p class="small">Escríbenos por WhatsApp con tu número de pedido.</p>
        <a class="btn btn-wa btn-sm" href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(waMessage ?? 'Hola, tengo una consulta.')}`} target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </aside>
  </div>
  <WaCta message={waMessage} />
</Base>
<style>
  .help-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 48px; align-items: start; padding-bottom: 56px; }
  .side { position: sticky; top: 90px; display: grid; gap: 16px; }
  .side h4 { font-size: 1rem; letter-spacing: 0.1em; margin-bottom: 10px; }
  .side-links { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .side-links a { text-decoration: none; color: var(--ink-2); display: block; padding: 6px 10px; border-radius: 8px; }
  .side-links a:hover { background: var(--surface-2); }
  .side-links a[aria-current] { background: var(--cyan); color: var(--blue-ink); font-weight: 600; }
  .side-wa p { margin-bottom: 10px; }
  @media (max-width: 900px) { .help-grid { grid-template-columns: 1fr; } .side { position: static; } }
</style>
