---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada" description="La página que buscas no existe." noindex trust={false}>
  <div class="container section" style="text-align:center">
    <h1>404</h1>
    <p class="lead" style="margin-inline:auto">Esa página no existe o cambió de lugar.</p>
    <div class="flex" style="justify-content:center"><a class="btn btn-primary" href="/">Ir al inicio</a><a class="btn btn-outline" href="/tienda/">Ver la tienda</a></div>
  </div>
</Base>
