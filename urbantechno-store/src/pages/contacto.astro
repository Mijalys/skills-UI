---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icons from '../components/Icons.astro';
import { SITE, waLink, socials, providerLine } from '../site.config.mjs';
---
<Base title="Contacto" description="Escríbenos por WhatsApp. Atención directa de lunes a sábado para pedidos, garantías y cambios.">
  <Breadcrumbs items={[{ name: 'Contacto' }]} />
  <div class="container page-hero"><h1>Hablemos</h1><p class="lead">WhatsApp es nuestro canal principal. Si ya compraste, ten a mano tu número de pedido.</p></div>
  <div class="container grid grid-3 section-tight" style="padding-top:0">
    <div class="card card-pad">
      <h2 class="h3">WhatsApp</h2>
      <p class="muted">{SITE.hours}</p>
      <a class="btn btn-wa" href={waLink('Hola, quiero hacer una consulta.')} target="_blank" rel="noopener"><Icons name="wa" />{SITE.whatsappDisplay}</a>
    </div>
    {SITE.email && (
      <div class="card card-pad">
        <h2 class="h3">Correo</h2>
        <p class="muted">Garantías, reclamos y comprobantes.</p>
        <a class="btn btn-outline" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    )}
    {socials().length > 0 && (
      <div class="card card-pad">
        <h2 class="h3">Redes</h2>
        <p class="muted">Novedades y stock en tiempo real.</p>
        <div class="flex">{socials().map((s) => <a class="btn btn-outline btn-sm" href={s.url} target="_blank" rel="noopener">{s.name}</a>)}</div>
      </div>
    )}
    <div class="card card-pad">
      <h2 class="h3">Reclamos</h2>
      <p class="muted">Registra tu reclamo o queja con número de hoja y copia para ti.</p>
      <a class="btn btn-outline" href="/libro-de-reclamaciones/">Libro de Reclamaciones</a>
    </div>
  </div>
  <div class="container section-tight" style="padding-top:0">
    <div class="summary">
      <h2 class="h3">Atajos</h2>
      <ul>
        <li><a href={waLink('Hola, quiero saber el estado de mi pedido N.º ')}>Estado de mi pedido</a></li>
        <li><a href={waLink('Hola, quiero activar la garantía de mi pedido N.º ')}>Activar garantía</a></li>
        <li><a href={waLink('Hola, quiero solicitar un cambio de talla de mi pedido N.º ')}>Cambio de talla</a></li>
        <li><a href="/libro-de-reclamaciones/">Libro de Reclamaciones</a></li>
      </ul>
    </div>
    {providerLine() && <p class="small muted mt-24">{providerLine()}</p>}
  </div>
</Base>
<style>
  .card :global(svg) { width: 20px; height: 20px; fill: currentColor; }
</style>
